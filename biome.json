{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"ignore": [
			"**/dist/**",
			"**/coverage/**",
			"**/.stryker-tmp/**",
			"**/node_modules/**",
			"**/.astro/**",
			"**/.changeset/*.md",
			"pnpm-lock.yaml"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"organizeImports": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"useExhaustiveDependencies": "warn"
			},
			"style": {
				"useConst": "error",
				"useTemplate": "error",
				"noNonNullAssertion": "error",
				"useNamingConvention": "off"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noConsole": { "level": "warn", "options": { "allow": ["warn", "error"] } }
			},
			"complexity": {
				"noUselessTypeConstraint": "error",
				"noBannedTypes": "error"
			},
			"performance": {
				"noAccumulatingSpread": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	},
	"overrides": [
		{
			"include": ["**/*.test.ts", "**/*.test.tsx", "**/*.bench.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off",
						"noConsole": "off"
					}
				}
			}
		},
		{
			"include": ["apps/docs/scripts/**", "**/*.config.*", "**/.size-limit.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	]
}

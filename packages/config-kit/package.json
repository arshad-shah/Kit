{
	"name": "@arshad-shah/config-kit",
	"version": "1.0.0",
	"description": "Typed config loader: env vars, .env files, and remote sources merged with schema validation.",
	"keywords": ["config", "env", "dotenv", "zod", "validation", "typescript"],
	"author": "Arshad Shah <hello@arshadshah.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arshad-shah/kit.git",
		"directory": "packages/config-kit"
	},
	"homepage": "https://kit.arshadshah.com/config-kit",
	"bugs": "https://github.com/arshad-shah/kit/issues",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": ["dist", "README.md", "LICENSE"],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:mutation": "stryker run",
		"typecheck": "tsc --noEmit",
		"size": "size-limit"
	},
	"peerDependencies": {
		"@arshad-shah/log-kit": "workspace:^",
		"zod": ">=3.22.0"
	},
	"peerDependenciesMeta": {
		"@arshad-shah/log-kit": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arshad-shah/internal-config": "workspace:*",
		"@arshad-shah/log-kit": "workspace:*",
		"@size-limit/preset-small-lib": "12.1.0",
		"@stryker-mutator/core": "8.7.1",
		"@stryker-mutator/typescript-checker": "8.7.1",
		"@stryker-mutator/vitest-runner": "8.7.1",
		"@types/node": "22.18.13",
		"@vitest/coverage-v8": "3.2.4",
		"size-limit": "12.1.0",
		"tsup": "8.5.1",
		"typescript": "5.7.2",
		"vitest": "3.2.4",
		"zod": "3.25.76"
	},
	"size-limit": [
		{
			"name": "ESM",
			"path": "dist/index.mjs",
			"limit": "2 KB",
			"gzip": true,
			"ignore": ["zod", "@arshad-shah/log-kit"]
		},
		{
			"name": "CJS",
			"path": "dist/index.cjs",
			"limit": "2.5 KB",
			"gzip": true,
			"ignore": ["zod", "@arshad-shah/log-kit"]
		}
	]
}

{
	"name": "@arshad-shah/store-kit",
	"version": "1.0.3",
	"description": "Tiny, typed Zustand factory with persistence, migrations, and devtools baked in.",
	"keywords": ["zustand", "store", "state", "react", "typescript", "persistence"],
	"author": "Arshad Shah <hello@arshadshah.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arshad-shah/kit.git",
		"directory": "packages/store-kit"
	},
	"homepage": "https://kit.arshadshah.com/store-kit",
	"bugs": "https://github.com/arshad-shah/kit/issues",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": ["dist", "README.md", "LICENSE"],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:mutation": "stryker run",
		"typecheck": "tsc --noEmit",
		"size": "size-limit"
	},
	"peerDependencies": {
		"zustand": ">=4.5.0 <6.0.0"
	},
	"devDependencies": {
		"@arshad-shah/internal-config": "workspace:*",
		"@size-limit/preset-small-lib": "12.1.0",
		"@stryker-mutator/core": "8.7.1",
		"@stryker-mutator/typescript-checker": "8.7.1",
		"@stryker-mutator/vitest-runner": "8.7.1",
		"@vitest/coverage-v8": "3.2.4",
		"jsdom": "27.4.0",
		"react": "18.3.1",
		"size-limit": "12.1.0",
		"tsup": "8.5.1",
		"typescript": "5.7.2",
		"vitest": "3.2.4",
		"zustand": "5.0.13"
	},
	"size-limit": [
		{
			"name": "ESM",
			"path": "dist/index.mjs",
			"limit": "2 KB",
			"gzip": true,
			"ignore": ["zustand"]
		},
		{
			"name": "CJS",
			"path": "dist/index.cjs",
			"limit": "2.5 KB",
			"gzip": true,
			"ignore": ["zustand"]
		}
	]
}

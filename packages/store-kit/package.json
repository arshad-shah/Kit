{
	"name": "@arshad-shah/store-kit",
	"version": "0.1.0",
	"description": "Tiny, typed Zustand factory with persistence, migrations, and devtools baked in.",
	"keywords": ["zustand", "store", "state", "react", "typescript", "persistence"],
	"author": "Arshad Shah <hello@arshadshah.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arshad-shah/kit.git",
		"directory": "packages/store-kit"
	},
	"homepage": "https://kit.arshadshah.com/store-kit",
	"bugs": "https://github.com/arshad-shah/kit/issues",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": ["dist", "README.md", "LICENSE"],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:mutation": "stryker run",
		"typecheck": "tsc --noEmit",
		"size": "size-limit"
	},
	"peerDependencies": {
		"zustand": ">=4.5.0 <6.0.0"
	},
	"devDependencies": {
		"@arshad-shah/internal-config": "workspace:*",
		"@size-limit/preset-small-lib": "11.1.6",
		"@stryker-mutator/core": "8.7.1",
		"@stryker-mutator/typescript-checker": "8.7.1",
		"@stryker-mutator/vitest-runner": "8.7.1",
		"@vitest/coverage-v8": "2.1.9",
		"jsdom": "25.0.1",
		"react": "18.3.1",
		"size-limit": "11.1.6",
		"tsup": "8.3.5",
		"typescript": "5.7.2",
		"vitest": "2.1.9",
		"zustand": "5.0.2"
	},
	"size-limit": [
		{
			"name": "ESM",
			"path": "dist/index.mjs",
			"limit": "2 KB",
			"gzip": true,
			"ignore": ["zustand"]
		},
		{
			"name": "CJS",
			"path": "dist/index.cjs",
			"limit": "2.5 KB",
			"gzip": true,
			"ignore": ["zustand"]
		}
	]
}

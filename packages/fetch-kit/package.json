{
	"name": "@arshad-shah/fetch-kit",
	"version": "1.0.3",
	"description": "Typed fetch client with retries, timeouts, schema validation, and React hooks.",
	"keywords": ["fetch", "http", "client", "react", "hooks", "typescript", "zod"],
	"author": "Arshad Shah <hello@arshadshah.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arshad-shah/kit.git",
		"directory": "packages/fetch-kit"
	},
	"homepage": "https://kit.arshadshah.com/fetch-kit",
	"bugs": "https://github.com/arshad-shah/kit/issues",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react.d.ts",
				"default": "./dist/react.mjs"
			},
			"require": {
				"types": "./dist/react.d.cts",
				"default": "./dist/react.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": ["dist", "README.md", "LICENSE"],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:mutation": "stryker run",
		"typecheck": "tsc --noEmit",
		"size": "size-limit"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"zod": ">=3.22.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arshad-shah/internal-config": "workspace:*",
		"@arshad-shah/store-kit": "workspace:*",
		"@size-limit/preset-small-lib": "12.1.0",
		"@stryker-mutator/core": "8.7.1",
		"@stryker-mutator/typescript-checker": "8.7.1",
		"@stryker-mutator/vitest-runner": "8.7.1",
		"@testing-library/react": "16.3.2",
		"@types/react": "18.3.18",
		"@vitest/coverage-v8": "3.2.4",
		"jsdom": "27.4.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"size-limit": "12.1.0",
		"tsup": "8.5.1",
		"typescript": "5.7.2",
		"vitest": "4.1.0",
		"zod": "3.25.76",
		"zustand": "5.0.13"
	},
	"size-limit": [
		{
			"name": "Core (ESM)",
			"path": "dist/index.mjs",
			"limit": "3.1 KB",
			"gzip": true,
			"ignore": ["react", "zod"]
		},
		{
			"name": "Core (CJS)",
			"path": "dist/index.cjs",
			"limit": "3.5 KB",
			"gzip": true,
			"ignore": ["react", "zod"]
		},
		{
			"name": "React hooks (ESM)",
			"path": "dist/react.mjs",
			"limit": "1.5 KB",
			"gzip": true,
			"ignore": ["react", "zod"]
		}
	]
}

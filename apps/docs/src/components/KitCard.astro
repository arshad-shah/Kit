---
import { Icon } from "astro-icon/components";

interface Props {
	title: string;
	icon: string;
	href?: string;
}

const { title, icon, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class="kit-card" href={href}>
	<header class="kit-card-header">
		<Icon name={icon} class="kit-card-icon" />
		<h3 class="kit-card-title">{title}</h3>
	</header>
	<div class="kit-card-body">
		<slot />
	</div>
</Tag>

<style>
	.kit-card {
		display: block;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		padding: 1.25rem;
		background: var(--sl-color-bg);
		text-decoration: none;
		color: inherit;
		transition: border-color 140ms ease, transform 140ms ease;
	}
	a.kit-card:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-1px);
	}
	.kit-card-header {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-bottom: 0.625rem;
	}
	.kit-card-icon {
		width: 1.25rem;
		height: 1.25rem;
		flex: 0 0 auto;
		color: var(--sl-color-accent);
	}
	.kit-card-title {
		font-family: var(--sl-font-system-mono);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		margin: 0;
		color: var(--sl-color-white);
		line-height: 1.2;
	}
	.kit-card-body {
		color: var(--sl-color-gray-2);
		font-size: 0.9rem;
		line-height: 1.5;
	}
	.kit-card-body :global(strong) {
		color: var(--sl-color-text);
	}
</style>
